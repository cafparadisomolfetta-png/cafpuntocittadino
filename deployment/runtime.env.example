# Example only. Copy outside the repository; never commit the completed file.
# These false flags deliberately prevent production startup before review.
CAF_PRIVATE_ENABLED=false
CAF_PRIVACY_REVIEWED=false
CAF_ORIGIN=http://127.0.0.1:8081
CAF_PORT=8080
CAF_TRUST_PROXY=true
CAF_PRIVATE_DIRECTORY=/var/lib/cafpuntocittadino
CAF_VAULT_KEY=
CAF_CLAMSCAN_PATH=/usr/bin/clamscan
GESTIONALE_GOOGLE_CLIENT_ID=
GESTIONALE_ADMIN_EMAIL=
GESTIONALE_OPERATORS_JSON='[]'
CAF_ENABLED_SITES_JSON='["molfetta"]'
# Configure the Molfetta calendar; other sites are disabled at launch.
GESTIONALE_SITE_CALENDARS_JSON=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
# Enable all 30 intake types only with an approved retention duration for each ID.
CAF_ENABLED_SERVICES_JSON=["730","isee","imu","successioni","locazioni","red","cartelle_fiscali","pensioni","contributi","reversibilita","naspi","invalidita_civile","invalidita_previdenziale","maternita_congedi","inps_altro","inail_infortunio","inail_malattia_professionale","inail_revisione","inail_altro","assegno_unico","adi","bonus_famiglia","bonus_sociali","scuola","lavoro","dimissioni","colf_badanti","consulenza","altro","tesseramento"]
CAF_RETENTION_DAYS_JSON=
CAF_CALLBACK_ENABLED=false
CAF_CV_RETENTION_DAYS=
CAF_BARI_SLOTS_JSON=
CAF_JOBS_ENABLED=false
CAF_MAIL_ENABLED=false
CAF_SENDER_EMAIL=
CAF_MAIL_RETENTION_DAYS=
CAF_AUDIT_RETENTION_DAYS=
CAF_AI_ENABLED=false
CAF_AI_SPEND_AUTHORIZED=false

# Public written contact links, read at build time. Rebuild after changing.
CAF_PUBLIC_CONTACT_EMAIL=cafparadiso.molfetta@gmail.com
# Verified WhatsApp Business number in international format (e.g. +39...), no spaces.
# Business number confirmed by the owner. Empty disables the public WhatsApp link.
CAF_PUBLIC_WHATSAPP_NUMBER=+390806455509
