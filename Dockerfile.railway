# Deployment candidate: staging only. Do not connect production DNS until review.
FROM node:22-alpine AS build
WORKDIR /app
COPY . .
RUN npm install --ignore-scripts --no-audit --no-fund && node deploy-build.cjs

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=8080
COPY package.json ./
RUN npm install --omit=dev --ignore-scripts --no-audit --no-fund
COPY --from=build /app/dist ./dist
COPY --from=build /app/server ./server
COPY --from=build /app/netlify/functions ./netlify/functions
USER node
EXPOSE 8080
CMD ["node","server/standalone.cjs"]
