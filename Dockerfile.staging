FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=8080
COPY package.json ./
RUN npm install --omit=dev --ignore-scripts --no-audit --no-fund
COPY server ./server
COPY netlify/functions ./netlify/functions
COPY dist ./dist
USER node
EXPOSE 8080
CMD ["node","server/standalone.cjs"]
